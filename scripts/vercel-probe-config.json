{
  "version": 3,
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": { "X-Probe": "config-json" },
      "continue": true
    },
    {
      "src": "^/probe/sub(/.*)?$",
      "status": 301,
      "headers": { "Location": "/probe-target$1" },
      "caseSensitive": true
    },
    {
      "src": "^/chainguard/chainctl(/.*)?$",
      "status": 301,
      "headers": { "Location": "/probe-chainctl$1" }
    },
    {
      "src": "^/chainguard/self-serve/overview(/.*)?$",
      "status": 301,
      "headers": { "Location": "/probe-stub$1" }
    },
    { "handle": "filesystem" },
    {
      "src": "^(.+)\\.md$",
      "dest": "$1/index.md",
      "check": true
    },
    {
      "src": "^/([^.]*[^/])$",
      "status": 301,
      "headers": { "Location": "/$1/" }
    },
    { "handle": "error" },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
