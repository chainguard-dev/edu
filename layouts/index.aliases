{{- /*
Builds the nginx map that turns every redirect rule into a 301. nginx.conf
includes the result as /etc/nginx/aliases. The rules, their order, and why
they are written the way they are live in layouts/partials/redirect-rules.html.

An exact path is written as a plain string, which nginx matches ignoring case;
everything else is a "~" regex, matched case-sensitively.
*/ -}}
{{- range partial "redirect-rules.html" . -}}
{{- $key := cond (ne .path "") .path (printf "~%s" .regex) -}}
"{{ $key }}" {{ .target }};
{{ end -}}
