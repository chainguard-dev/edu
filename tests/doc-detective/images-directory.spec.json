{
  "specId": "images-directory",
  "description": "Tests for content/platform/console/images-directory/index.md. Console tests need a session: run with tests/doc-detective/console-cookie.sh --input tests/doc-detective/images-directory.spec.json",
  "tests": [
    {
      "testId": "console-opens-on-overview",
      "description": "Signing in opens the Overview page",
      "steps": [
        {
          "description": "Get onto chainguard.dev so the session cookie can be set. The favicon skips the login redirect",
          "goTo": {
            "url": "https://console.chainguard.dev/favicon.ico",
            "waitUntil": {
              "networkIdleTime": null,
              "domIdleTime": null
            }
          }
        },
        {
          "description": "Sign in with the token in CHAINGUARD_SESSION_COOKIE. Run with tests/doc-detective/console-cookie.sh",
          "loadCookie": {
            "name": "chainguard-session",
            "variable": "CHAINGUARD_SESSION_COOKIE"
          }
        },
        {
          "description": "Mark the cookie banner as answered. It appears only sometimes, so a click step would be flaky",
          "loadCookie": {
            "name": "OptanonAlertBoxClosed",
            "variable": "CHAINGUARD_CONSENT_COOKIE"
          }
        },
        {
          "description": "Open the Console",
          "goTo": {
            "url": "https://console.chainguard.dev/",
            "waitUntil": {
              "networkIdleTime": null,
              "domIdleTime": 0
            }
          }
        },
        {
          "description": "The Overview item in the navigation menu is selected",
          "find": {
            "selector": "nav a.Mui-selected[aria-label='Overview']",
            "timeout": 30000
          }
        }
      ]
    },
    {
      "testId": "console-images-organization-tab",
      "description": "Images opens on the Organization tab, with its columns, search box, and Filter by menu",
      "steps": [
        {
          "description": "Get onto chainguard.dev so the session cookie can be set. The favicon skips the login redirect",
          "goTo": {
            "url": "https://console.chainguard.dev/favicon.ico",
            "waitUntil": {
              "networkIdleTime": null,
              "domIdleTime": null
            }
          }
        },
        {
          "description": "Sign in with the token in CHAINGUARD_SESSION_COOKIE. Run with tests/doc-detective/console-cookie.sh",
          "loadCookie": {
            "name": "chainguard-session",
            "variable": "CHAINGUARD_SESSION_COOKIE"
          }
        },
        {
          "description": "Mark the cookie banner as answered. It appears only sometimes, so a click step would be flaky",
          "loadCookie": {
            "name": "OptanonAlertBoxClosed",
            "variable": "CHAINGUARD_CONSENT_COOKIE"
          }
        },
        {
          "description": "Open the Console",
          "goTo": {
            "url": "https://console.chainguard.dev/",
            "waitUntil": {
              "networkIdleTime": null,
              "domIdleTime": 0
            }
          }
        },
        {
          "description": "Open Images from the navigation menu",
          "find": {
            "selector": "nav a",
            "elementText": "Images",
            "click": true,
            "timeout": 30000
          }
        },
        {
          "description": "The Organization tab is selected",
          "find": {
            "selector": "[role='tab'][aria-selected='true']",
            "elementText": "Organization",
            "timeout": 30000
          }
        },
        {
          "description": "The table has a Name column",
          "find": {
            "selector": "[role='columnheader']",
            "elementText": "Name",
            "timeout": 30000
          }
        },
        {
          "description": "The table has a Latest tag column",
          "find": {
            "selector": "[role='columnheader']",
            "elementText": "Latest tag"
          }
        },
        {
          "description": "The table has a Status column",
          "find": {
            "selector": "[role='columnheader']",
            "elementText": "Status"
          }
        },
        {
          "description": "The table has a Pull URL column",
          "find": {
            "selector": "[role='columnheader']",
            "elementText": "Pull URL"
          }
        },
        {
          "description": "The table has a Updated column",
          "find": {
            "selector": "[role='columnheader']",
            "elementText": "Updated"
          }
        },
        {
          "description": "The search box is above the table",
          "find": {
            "selector": "input[placeholder='Search organization images...']"
          }
        },
        {
          "description": "Wait for the first row of images. Filter by stays disabled until the table loads",
          "find": {
            "selector": "[role='row'][data-rowindex='0']",
            "timeout": 30000
          }
        },
        {
          "description": "The Filter by menu is present. Its text also holds a hidden filter count, so match the end",
          "find": {
            "selector": "button[aria-haspopup='true']",
            "elementText": "/Filter by$/"
          }
        }
      ]
    },
