{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD026": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    // Nested list items use 4-space indentation in this repo's docs.
    "MD007": { "indent": 4 },
    "MD040": false,
    // Descriptive-link-text: editorial and subjective; also flags deliberate
    // compact table-cell links. Left to author judgment rather than enforced.
    "MD059": false,
    // Table style rules disabled: they enforce cosmetic pipe alignment/style
    // that is high-churn and not autofixable, without improving rendering.
    "MD055": false,
    "MD060": false
  },
  "ignores": [
    "node_modules",
    "CHANGELOG.md",
    "README.md",
    // chainctl reference docs are autogenerated from the chainctl source;
    // lint fixes here would be overwritten on the next generation run.
    "content/platform/chainctl/chainctl-docs",
    // Concatenation of every docs page, produced by scripts/compile_docs.py.
    // It inherits ~35k style violations from the pages it bundles, and any fix
    // is lost on the next run. pre-commit only lints changed files, so this
    // stayed out of scope until an edit touched it for the first time.
    "static/downloads/chainguard-complete-docs.md"
  ]
}
